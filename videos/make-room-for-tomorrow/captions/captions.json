{
 "cues": [
  {
   "start": 0.55,
   "end": 2.22,
   "text": "Your shop is closed."
  },
  {
   "start": 2.25,
   "end": 4.56,
   "text": "Your head is still doing the accounts."
  },
  {
   "start": 4.95,
   "end": 8.34,
   "text": "Cash. MoMo. Stock. Delivery."
  },
  {
   "start": 8.37,
   "end": 9.87,
   "text": "Kojo still owes you."
  },
  {
   "start": 9.9,
   "end": 11.77,
   "text": "Abena paid part of her debt."
  },
  {
   "start": 11.8,
   "end": 14.32,
   "text": "Your day… in pieces."
  },
  {
   "start": 14.35,
   "end": 16.79,
   "text": "Give your money story somewhere to live."
  },
  {
   "start": 16.85,
   "end": 18.48,
   "text": "Meet CashNarra."
  },
  {
   "start": 18.55,
   "end": 20.35,
   "text": "Type it as it happened."
  },
  {
   "start": 20.95,
   "end": 23.18,
   "text": "It turns your words into records."
  },
  {
   "start": 24.15,
   "end": 27.65,
   "text": "You check the details, fill in what’s missing, and save."
  },
  {
   "start": 30.15,
   "end": 32.71,
   "text": "Abena’s payment reduces her debt."
  },
  {
   "start": 32.85,
   "end": 35.07,
   "text": "Kojo still owes three hundred."
  },
  {
   "start": 35.35,
   "end": 38.84,
   "text": "You see what came in, what went out, and what’s still owed."
  },
  {
   "start": 41.85,
   "end": 43.32,
   "text": "Now look ahead."
  },
  {
   "start": 43.35,
   "end": 45.81,
   "text": "That new equipment. Your progress."
  },
  {
   "start": 45.95,
   "end": 48.53,
   "text": "What a different contribution could change."
  },
  {
   "start": 49.75,
   "end": 51.35,
   "text": "You’ve done the work."
  },
  {
   "start": 51.45,
   "end": 53.36,
   "text": "Make room for tomorrow."
  },
  {
   "start": 53.95,
   "end": 55.31,
   "text": "CashNarra."
  },
  {
   "start": 55.45,
   "end": 58.04,
   "text": "Tell your money story. See the numbers."
  },
  {
   "start": 58.15,
   "end": 59.54,
   "text": "Coming soon."
  }
