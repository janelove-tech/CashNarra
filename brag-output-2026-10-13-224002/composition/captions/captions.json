{
 "cues": [
  {
   "start": 0.65,
   "end": 4.94,
   "text": "Every evening, before I lock up, I tell my phone how the day went.",
   "burn": true
  },
  {
   "start": 5.35,
   "end": 7.47,
   "text": "🎙 Today I sold GH₵2,400:",
   "burn": false
  },
  {
   "start": 7.47,
   "end": 9.91,
   "text": "🎙 GH₵900 cash, GH₵1,200 MoMo,",
   "burn": false
  },
  {
   "start": 9.91,
   "end": 12.37,
   "text": "🎙 and Kojo still owes GH₵300.",
   "burn": false
  },
  {
   "start": 12.37,
   "end": 14.67,
   "text": "🎙 I bought GH₵700 of stock with cash,",
   "burn": false
  },
  {
   "start": 14.67,
   "end": 16.07,
   "text": "🎙 paid GH₵80 delivery,",
   "burn": false
  },
  {
   "start": 16.07,
   "end": 18.47,
   "text": "🎙 moved GH₵500 from bank to MoMo,",
   "burn": false
  },
  {
   "start": 18.47,
   "end": 21.01,
   "text": "🎙 Abena paid GH₵200 of what she owed into MoMo,",
   "burn": false
  },
  {
   "start": 21.01,
   "end": 23.4,
   "text": "🎙 and I took GH₵150 cash home.",
   "burn": false
  },
  {
   "start": 23.55,
   "end": 26.22,
   "text": "No forms. No accounting words.",
   "burn": true
  },
  {
   "start": 26.25,
   "end": 29.55,
   "text": "Busy with a customer? I type it as it happens.",
   "burn": true
  },
  {
   "start": 30.65,
   "end": 33.42,
   "text": "CashNarra turns my words into records.",
   "burn": true
  },
  {
   "start": 33.45,
   "end": 37.07,
   "text": "It asks what I left out. Which account paid for delivery?",
   "burn": true
  },
  {
   "start": 37.1,
   "end": 40.46,
   "text": "MoMo. I check all eight, and I save.",
   "burn": true
  },
  {
   "start": 41.25,
   "end": 45.42,
   "text": "Abena’s GH₵200 is not a new sale. She owes GH₵400 now.",
   "burn": true
  },
  {
   "start": 45.45,
   "end": 47.52,
   "text": "Kojo still owes GH₵300.",
   "burn": true
  },
  {
   "start": 47.55,
   "end": 51.93,
   "text": "GH₵2,300 came in. GH₵930 went out.",
   "burn": true
  },
  {
   "start": 52.85,
   "end": 55.52,
   "text": "My day. My words. My numbers.",
   "burn": true
  },
  {
   "start": 55.55,
   "end": 58.12,
   "text": "Tell your money story. See the numbers.",
   "burn": true
  },
  {
   "start": 58.15,
   "end": 59.54,
   "text": "Coming soon.",
   "burn": true
  }
 ],
