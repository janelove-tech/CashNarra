NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
OPENAI_API_KEY=
AI_ENABLED=false
OPENAI_MODEL=gpt-4.1-mini-2025-04-14
AI_DAILY_CALL_LIMIT=10
VOICE_ENABLED=false
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
DEMO_ENABLED=true
# Isolated development database only.
TEST_DATABASE_URL=
SITE_URL=http://127.0.0.1:3100
# Configure in Supabase Auth SMTP:
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=
SMTP_FROM=

# Set only after representative short-clip quality testing.
VOICE_QUALITY_APPROVED=false
# Local-only transcription testing uses the existing cumulative evaluation budget.
# Requires LOCAL_AI_BUDGET=true, loopback SITE_URL, and an audio-capable API key.
# Does not approve voice quality or enable production use.
LOCAL_VOICE_TESTING=false


# Local, single-process user testing only: share the existing approved evaluation
# journal. Requires its pre-existing .local/evaluation/budget.jsonl; never initialise
# an extra allowance. Keep false on deployed hosts. Voice remains separately gated.
LOCAL_AI_BUDGET=false
# Speech-to-text for the local voice pilot. Leave the key blank until you add one.
# Never put this key in a NEXT_PUBLIC_ field.
GROQ_API_KEY=
TRANSCRIPTION_PROVIDER=groq
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
# Owner-only local check of the two-minute Plus recording length.
# A browser cannot turn this on, and it does not sell Plus.
CASHNARRA_VOICE_PLUS_DURATION=false
# Server-only user ids for the platform owner console. Empty means nobody.
# Do not put this role in account metadata. Demo sessions are never owners.
CASHNARRA_PLATFORM_OWNER_IDS=
# On this Windows development machine, start Node with NODE_USE_SYSTEM_CA=1
# to trust system certificates without disabling TLS verification.
